# demo (default) needs no credentials.
# Set DATA_MODE to supabase and provide the keys below to use Supabase Auth,
# Postgres, and private storage. The anon key is public. The service role key
# is server-only and must never use a NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Leave unset. Document analysis does not call an AI provider.
# AUDITREADY_AI_PROVIDER=
